<?xml version="1.0" encoding="utf-8"?>
<!--
  Aurora Music Player — proyecto de AIDE (clásico, sin Gradle).

  Para compilar: abre esta carpeta como proyecto en AIDE y pulsa Run.
  No hay dependencias externas ni repositorios que descargar.

  La app web vive en assets/www y se sirve al WebView desde
  https://aurora.localhost (ver AuroraWebClient.java).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nelsondev2.aurora"
    android:versionCode="130"
    android:versionName="1.3.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="33" />

    <!-- No hay red: los recursos se interceptan desde assets. El permiso
         solo evita que el WebView rechace el origen https ficticio. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/AuroraTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Archivos exportados (compartir) con permiso temporal de lectura -->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.nelsondev2.aurora.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
